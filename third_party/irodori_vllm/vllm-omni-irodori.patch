@@ -0,0 +1,17 @@
+# Irodori-TTS deploy: diffusion engine single stage (RF-DiT + DACVAE, 48 kHz).
+# Concurrent /v1/audio/speech requests are grouped by the request batcher and run through
+# Irodori's synthesize_batch (results equal unbatched ones).
+async_chunk: false
+pipeline: irodori_tts
+
+stages:
+  - stage_id: 0
+    devices: "0"
+    enforce_eager: true
+    trust_remote_code: true
+    distributed_executor_backend: "mp"
+    dtype: "float32"
+    # 16 concurrent requests per batch (1.07x vs 8 on RTX 3090). Results equal unbatched synthesis up to
+    # floating-point batching noise.
+    max_num_seqs: 16
+    request_batch_max_wait_ms: 20
